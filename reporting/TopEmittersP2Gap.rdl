  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="EmissionsAnalyticsDataSource">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQLAZURE</DataProvider>
        <ConnectString>Data Source=sql-emissions-claire.database.windows.net;Initial Catalog=emissions-analytics;Encrypt=True;Trust Server Certificate=False;Authentication=SqlPassword</ConnectString>
        <Prompt>Specify a user name and password for data source EmissionsAnalyticsDataSource:</Prompt>
      </ConnectionProperties>
      <rd:DataSourceID>42806fea-dd30-4b2c-96a1-1f7a987d6655</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ProvinceList">
      <Query>
        <DataSourceName>EmissionsAnalyticsDataSource</DataSourceName>
        <CommandText>
          SELECT DISTINCT province
          FROM dbo.vw_p2_gap_analysis
          WHERE emitter_tier = 'Top emitter (100kt+)'
          ORDER BY province
        </CommandText>
      </Query>
      <Fields>
        <Field Name="province">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>province</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TopEmittersP2Gap">
      <Query>
        <DataSourceName>EmissionsAnalyticsDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Province">
            <Value>=Parameters!Province.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
          SELECT facility_name, province, naics_description,
                 latest_year_co2e_tonnes, has_p2_plan, has_p2_activity
          FROM dbo.vw_p2_gap_analysis
          WHERE emitter_tier = 'Top emitter (100kt+)'
            AND province IN (@Province)
          ORDER BY province, latest_year_co2e_tonnes DESC
        </CommandText>
      </Query>
      <Fields>
        <Field Name="facility_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>facility_name</DataField>
        </Field>
        <Field Name="province">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>province</DataField>
        </Field>
        <Field Name="naics_description">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>naics_description</DataField>
        </Field>
        <Field Name="latest_year_co2e_tonnes">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>latest_year_co2e_tonnes</DataField>
        </Field>
        <Field Name="has_p2_plan">
          <rd:TypeName>System.Boolean</rd:TypeName>
          <DataField>has_p2_plan</DataField>
        </Field>
        <Field Name="has_p2_activity">
          <rd:TypeName>System.Boolean</rd:TypeName>
          <DataField>has_p2_activity</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>

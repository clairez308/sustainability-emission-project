# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.

AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=emissions-analytics
AZURE_SQL_USERNAME=your-admin-username
AZURE_SQL_PASSWORD=your-admin-password

MONGO_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net

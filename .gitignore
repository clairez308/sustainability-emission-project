# Raw government source files -- large, and fully reproducible via the
# download steps in README.md + data_prep/clean_and_prepare.py
data/raw/*.csv

# Python
.venv/
__pycache__/
*.pyc

# Secrets -- never commit connection strings/passwords
.env
!.env.example

# Power BI Project (.pbip) local editor state -- machine-specific, regenerated
# by Desktop, and cache.abf may hold a local data cache of the semantic model
**/.pbi/
